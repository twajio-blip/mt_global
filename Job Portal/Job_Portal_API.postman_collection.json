						},
						"description": "Returns list of active countries with id, name, ISO code, and flag emoji. Requires X-API-KEY header."
					},
					"response": []
				},
				{
					"name": "Get Active Designations",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/v1/designations",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"designations"
							]
						},
						"description": "Returns list of active job categories / designations. Requires X-API-KEY header."
					},
					"response": []
				},
				{
					"name": "Get Company Details & QR",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/v1/company",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"company"
							]
						},
						"description": "Returns company profile: name, email, phone, address, website, logo URL, and official QR code image URL. Requires X-API-KEY header."
					},
					"response": []
				}
			]
		},
		{
			"name": "3. Jobs Discovery",
			"description": "Endpoints to search, filter, paginate, and view published manpower job listings.",
			"item": [
				{
					"name": "List All Published Jobs",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/v1/jobs?page=1&per_page=12",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"jobs"
							],
							"query": [
								{
									"key": "page",
									"value": "1",
									"description": "Current page number"
								},
								{
									"key": "per_page",
									"value": "12",
									"description": "Number of jobs per page (max 100)"
								}
							]
						},
						"description": "Fetches paginated list of published jobs. Requires X-API-KEY header."
					},
					"response": []
				},
				{
