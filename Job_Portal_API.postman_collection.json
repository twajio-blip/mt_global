{
	"info": {
		"_postman_id": "8f42e3b1-9c71-4a3e-b816-1f92e4a60001",
		"name": "Job Portal & Manpower Recruitment API",
		"description": "Complete REST API collection for connecting website builders (WordPress, Webflow, Wix, custom frontends) to the Job Portal & Manpower CV Management System.\n\nAll endpoints accept standard JSON headers and handle multipart/form-data for file uploads.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://127.0.0.1:8000",
			"type": "string",
			"description": "Base URL of the Laravel Application (e.g. http://127.0.0.1:8000 or your production domain)"
		},
		{
			"key": "sampleJobCode",
			"value": "KSA-2026-001",
			"type": "string",
			"description": "Sample Job Code or Numeric ID for testing single job requests"
		},
		{
			"key": "sampleJobId",
			"value": "1",
			"type": "string",
			"description": "Sample Numeric Job ID"
		}
	],
	"item": [
		{
			"name": "1. Metadata & Dropdowns",
			"description": "Endpoints to populate country, designation, and filter dropdowns in the website builder.",
			"item": [
				{
					"name": "Get Active Countries",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/v1/countries",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"countries"
							]
						},
						"description": "Returns list of active countries with id, name, ISO code, and flag emoji for location dropdowns."
					},
					"response": []
				},
				{
					"name": "Get Active Designations",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/v1/designations",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"designations"
							]
						},
						"description": "Returns list of active job categories / designations."
					},
					"response": []
				}
			]
		},
		{
			"name": "2. Jobs Discovery",
			"description": "Endpoints to search, filter, paginate, and view published manpower job listings.",
			"item": [
				{
					"name": "List All Published Jobs",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/v1/jobs?page=1&per_page=12",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"jobs"
							],
							"query": [
								{
									"key": "page",
									"value": "1",
									"description": "Current page number"
								},
								{
									"key": "per_page",
									"value": "12",
									"description": "Number of jobs per page (max 100)"
								}
							]
						},
						"description": "Fetches paginated list of published jobs with country, designation, and pagination metadata."
					},
					"response": []
				},
				{
					"name": "Search Jobs by Keyword",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/v1/jobs?search=Electrician",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"jobs"
							],
							"query": [
								{
									"key": "search",
									"value": "Electrician",
									"description": "Search keyword matching job title (EN/BN), job code, or employer name"
								}
							]
						},
						"description": "Searches published jobs by English/Bangla title, job code, or employer."
					},
					"response": []
				},
				{
					"name": "Filter Jobs by Country",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/v1/jobs?country=Saudi Arabia",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"jobs"
							],
							"query": [
								{
									"key": "country",
									"value": "Saudi Arabia",
									"description": "Country name, ISO code (e.g. SA, QA), or country ID"
								}
							]
						},
						"description": "Filters jobs by country name, country ISO code, or country_id."
					},
					"response": []
				},
				{
					"name": "Filter Jobs by Designation",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/v1/jobs?designation=Lineman",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"jobs"
							],
							"query": [
								{
									"key": "designation",
									"value": "Lineman",
									"description": "Designation name or designation ID"
								}
							]
						},
						"description": "Filters jobs by designation name or designation_id."
					},
					"response": []
				},
				{
					"name": "Get Single Job Details (by Job Code or ID)",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/v1/jobs/{{sampleJobCode}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"jobs",
								"{{sampleJobCode}}"
							]
						},
						"description": "Fetches complete job details, candidate requirements, interview details, benefits list, and related jobs. Accepts either Job Code (e.g. KSA-2026-001) or Numeric ID."
					},
					"response": []
				}
			]
		},
		{
			"name": "3. Candidate Applications (Quick Apply)",
			"description": "Endpoints for submitting candidate job applications with file attachments.",
			"item": [
				{
					"name": "Submit Job Application (Multipart Upload)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "formdata",
							"formdata": [
								{
									"key": "full_name",
									"value": "Md Sumon Ali",
									"type": "text",
									"description": "Candidate full name (Required)"
								},
								{
									"key": "passport_number",
									"value": "B00788472",
									"type": "text",
									"description": "Candidate passport number - used as unique candidate identifier (Required)"
								},
								{
									"key": "mobile_number",
									"value": "01712345678",
									"type": "text",
									"description": "Candidate mobile / WhatsApp number (Required)"
								},
								{
									"key": "experience_years",
									"value": "4 Years",
									"type": "text",
									"description": "Candidate total years of experience (Required)"
								},
								{
									"key": "has_overseas_experience",
									"value": "true",
									"type": "text",
									"description": "true / false / 1 / 0 (Required)"
								},
								{
									"key": "current_location",
									"value": "1",
									"type": "text",
									"description": "Country ID from /countries (e.g. 1 for Bangladesh) or ISO code like BD (Required)"
								},
								{
									"key": "cv_file",
									"type": "file",
									"src": [],
									"description": "Curriculum Vitae file: PDF, DOC, DOCX, JPG, PNG up to 5MB (Required)"
								},
								{
									"key": "passport_file",
									"type": "file",
									"src": [],
									"description": "Passport scan / photo up to 5MB (Optional)"
								},
								{
									"key": "photo_file",
									"type": "file",
									"src": [],
									"description": "Candidate passport-size photo up to 5MB (Optional)"
								}
							]
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/jobs/{{sampleJobCode}}/apply",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"jobs",
								"{{sampleJobCode}}",
								"apply"
							]
						},
						"description": "Submits a new job application. Creates candidate account if not exists, uploads up to 3 documents, and creates a Pending application record in the agency portal."
					},
					"response": []
				}
			]
		},
		{
			"name": "4. Direct Web Routes (Inertia / JSON Dual Mode)",
			"description": "The exact same public web URLs also return JSON if requested with header 'Accept: application/json'.",
			"item": [
				{
					"name": "GET /jobs (Direct Web Route with JSON Header)",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/jobs",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"jobs"
							]
						},
						"description": "Calling /jobs with 'Accept: application/json' returns JSON data instead of Inertia HTML."
					},
					"response": []
				},
				{
					"name": "GET /jobs/:job (Direct Web Route with JSON Header)",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/jobs/{{sampleJobCode}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"jobs",
								"{{sampleJobCode}}"
							]
						},
						"description": "Calling /jobs/{job} with 'Accept: application/json' returns JSON details."
					},
					"response": []
				},
				{
					"name": "POST /jobs/:job/apply (Direct Web Route with JSON Header)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "formdata",
							"formdata": [
								{
									"key": "full_name",
									"value": "Md Sumon Ali",
									"type": "text"
								},
								{
									"key": "passport_number",
									"value": "B00788472",
									"type": "text"
								},
								{
									"key": "mobile_number",
									"value": "01712345678",
									"type": "text"
								},
								{
									"key": "experience_years",
									"value": "4 Years",
									"type": "text"
								},
								{
									"key": "has_overseas_experience",
									"value": "true",
									"type": "text"
								},
								{
									"key": "current_location",
									"value": "1",
									"type": "text"
								},
								{
									"key": "cv_file",
									"type": "file",
									"src": []
								}
							]
						},
						"url": {
							"raw": "{{baseUrl}}/jobs/{{sampleJobCode}}/apply",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"jobs",
								"{{sampleJobCode}}",
								"apply"
							]
						},
						"description": "Calling /jobs/{job}/apply with 'Accept: application/json' returns 201 Created JSON response."
					},
					"response": []
				}
			]
		}
	]
}

